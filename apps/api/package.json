{
  "name": "@digicasino/api",
  "private": true,
  "version": "0.1.0",
  "description": "digiCasino backend API (Task 001 — Foundation): health, auth, and the minimal wallet module.",
  "main": "dist/index.js",
  "scripts": {
    "predev": "npm run prisma:generate --silent && DATABASE_URL=\"file:./dev.db\" prisma migrate deploy --schema=../../prisma/schema.prisma",
    "dev": "tsx watch src/index.ts",
    "prebuild": "npm run prisma:generate --silent",
    "build": "tsc -p tsconfig.json",
    "prestart": "DATABASE_URL=\"file:./dev.db\" prisma migrate deploy --schema=../../prisma/schema.prisma",
    "start": "node dist/index.js",
    "lint": "tsc -p tsconfig.json --noEmit",
    "prisma:generate": "DATABASE_URL=\"file:./dev.db\" prisma generate --schema=../../prisma/schema.prisma",
    "prisma:migrate": "DATABASE_URL=\"file:./dev.db\" prisma migrate dev --schema=../../prisma/schema.prisma",
    "pretest": "npm run prisma:generate --silent && DATABASE_URL=\"file:./test.db\" prisma migrate deploy --schema=../../prisma/schema.prisma",
    "test": "DATABASE_URL=\"file:./test.db\" vitest run"
  },
  "dependencies": {
    "@prisma/client": "6.19.3",
    "bcryptjs": "^3.0.3",
    "dotenv": "^17.4.2",
    "express": "^4.22.3",
    "jsonwebtoken": "^9.0.3"
  },
  "devDependencies": {
    "@types/express": "^4.17.25",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.20.3",
    "@types/supertest": "^6.0.3",
    "prisma": "6.19.3",
    "supertest": "^7.2.2",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2",
    "vitest": "^5.0.1"
  }
}
