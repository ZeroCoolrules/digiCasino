# Copy this file to .env and fill in values for local development.
# Never commit the real .env file (see .gitignore).

# apps/api
DATABASE_URL="file:./dev.db"
JWT_SECRET="replace-with-a-long-random-string"
PORT=4000
# Comma-separated emails auto-promoted to the ADMIN role on register/login (Task 003).
# Leave empty/unset if you don't need admin access locally.
ADMIN_EMAILS=""

# apps/web
VITE_API_BASE_URL="http://localhost:4000/api/v1"
